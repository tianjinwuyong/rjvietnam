{
  "version": "1.0.0",
  "updatedBy": "manager_zhang",
  "updatedAt": "2026-06-28T10:00:00Z",
  "description": "WMS AI Manager — Standard Patrol Cycle SOP",
  "steps": [
    {
      "id": "step_query",
      "name": "Query Database",
      "nameZh": "查询数据库",
      "type": "QUERY",
      "script": "services/worker/watchdog-query.js",
      "args": ["all"],
      "outputVar": "wmsData",
      "timeoutSec": 30,
      "onError": "ABORT",
      "next": "step_delta",
      "mermaid": { "icon": "1️⃣", "color": "#4CAF50" }
    },
    {
      "id": "step_delta",
      "name": "Delta Detection",
      "nameZh": "变更检测",
      "type": "SCRIPT",
      "function": "detectChanges",
      "args": ["wmsData"],
      "outputVar": "newNgLots, newWo",
      "next": "step_ornith",
      "mermaid": { "icon": "2️⃣", "color": "#4CAF50" }
    },
    {
      "id": "step_ornith",
      "name": "AI Analysis (Ornith)",
      "nameZh": "AI分析",
      "type": "LLM",
      "model": "ornith",
      "promptTemplate": "patrolPrompt",
      "outputVar": "analysis",
      "timeoutSec": 120,
      "onError": "SKIP_TO step_audit",
      "next": "step_vision",
      "mermaid": { "icon": "3️⃣", "color": "#FFD700" }
    },
    {
      "id": "step_vision",
      "name": "Visual Inspection",
      "nameZh": "视觉检测",
      "type": "BRANCH_VISION",
      "condition": "analysis.needsVision == true",
      "next": "step_execute",
      "mermaid": { "icon": "📷", "color": "#9C27B0" }
    },
    {
      "id": "step_execute",
      "name": "Route to Handlers",
      "nameZh": "执行分支",
      "type": "BRANCH",
      "branches": [
        { "condition": "analysis.iqc_decisions?.length > 0", "next": "step_iqc" },
        { "condition": "analysis.msd_alerts?.length > 0", "next": "step_msd" },
        { "condition": "analysis.issue_to_line?.length > 0", "next": "step_issue" },
        { "condition": "analysis.return_to_line?.length > 0", "next": "step_return" },
        { "condition": "analysis.scrap?.length > 0", "next": "step_scrap" },
        { "condition": "analysis.put_away?.length > 0", "next": "step_putaway" }
      ],
      "defaultNext": "step_escalation",
      "mermaid": { "icon": "4️⃣", "color": "#FF9800" }
    },
    {
      "id": "step_iqc",
      "name": "IQC Execution",
      "nameZh": "IQC执行",
      "type": "EXECUTE",
      "handler": "executeIqcDecisions",
      "target": "analysis.iqc_decisions",
      "next": "step_escalation",
      "mermaid": { "icon": "🔨", "color": "#F44336" }
    },
    {
      "id": "step_msd",
      "name": "MSD Guardian",
      "nameZh": "MSD处理",
      "type": "EXECUTE",
      "handler": "handleMsdAlerts",
      "target": "analysis.msd_alerts",
      "next": "step_escalation",
      "mermaid": { "icon": "⚠️", "color": "#FF9800" }
    },
    {
      "id": "step_issue",
      "name": "Issue to Line",
      "nameZh": "发料到产线",
      "type": "EXECUTE",
      "handler": "executeIssueToLine",
      "target": "analysis.issue_to_line",
      "next": "step_escalation",
      "mermaid": { "icon": "📦", "color": "#2196F3" }
    },
    {
      "id": "step_return",
      "name": "Return to Line",
      "nameZh": "退料到产线",
      "type": "EXECUTE",
      "handler": "executeReturnLine",
      "target": "analysis.return_to_line",
      "next": "step_escalation",
      "mermaid": { "icon": "↩️", "color": "#2196F3" }
    },
    {
      "id": "step_scrap",
      "name": "Scrap",
      "nameZh": "报废处理",
      "type": "EXECUTE",
      "handler": "executeScrap",
      "target": "analysis.scrap",
      "next": "step_escalation",
      "mermaid": { "icon": "🗑️", "color": "#9E9E9E" }
    },
    {
      "id": "step_putaway",
      "name": "Put Away",
      "nameZh": "上架存储",
      "type": "EXECUTE",
      "handler": "executePutAway",
      "target": "analysis.put_away",
      "next": "step_escalation",
      "mermaid": { "icon": "📥", "color": "#4CAF50" }
    },
    {
      "id": "step_escalation",
      "name": "Escalation Check",
      "nameZh": "升级判断",
      "type": "ESCALATION",
      "next": "step_audit",
      "mermaid": { "icon": "🚨", "color": "#FF5722" }
    },
    {
      "id": "step_audit",
      "name": "Evaluate & Log",
      "nameZh": "评分与日志",
      "type": "EVALUATE",
      "script": "services/worker/wms-evaluator.js",
      "args": ["score-recent", "--limit", "5"],
      "next": "step_pending",
      "mermaid": { "icon": "5️⃣", "color": "#4CAF50" }
    },
    {
      "id": "step_pending",
      "name": "Save Pending Approvals",
      "nameZh": "待审批队列",
      "type": "PENDING",
      "next": "step_line",
      "mermaid": { "icon": "📋", "color": "#607D8B" }
    },
    {
      "id": "step_line",
      "name": "LINE Notification",
      "nameZh": "LINE通知",
      "type": "LINE",
      "condition": "hasAlerts(analysis)",
      "next": "step_save",
      "mermaid": { "icon": "6️⃣", "color": "#4CAF50" }
    },
    {
      "id": "step_save",
      "name": "Save State",
      "nameZh": "保存状态",
      "type": "SAVE_STATE",
      "next": "END",
      "mermaid": { "icon": "💾", "color": "#4CAF50" }
    }
  ],
  "startStep": "step_query",
  "escalation": {
    "step_query": { "timeoutSec": 30, "level": "ALERT", "message": "数据库查询超时" },
    "step_ornith": { "timeoutSec": 120, "level": "WARN", "message": "Ornith分析超时，跳过执行" }
  }
}
