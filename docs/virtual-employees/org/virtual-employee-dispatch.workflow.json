  "cards": [
    {
      "dot": "cyan",
      "title": "三层不变式",
      "items": [
        "人类只做审批，虚拟员工永远不能自批",
        "一个事件只有一个主责岗位，其余只能交接不能抢单",
        "所有写入经过 Express 权限与审计，Hermes 不得直连数据库"
      ]
    },
    {
      "dot": "rose",
      "title": "审批门的真实边界",
      "items": [
        "11 类动作已在注册表 humanGates 中声明（批准 PO、改价、停线、放行物料等）",
        "驳回只退回到补证，不重新派工，避免责任漂移",
        "每一次事件都写入 factory_virtual_employee_events 供追溯"
      ]
    },
    {
      "dot": "emerald",
      "title": "当前落地程度",
      "items": [
        "已实现执行器：OPS-SUPERVISOR / WMS-RECEIVING / WMS-INVENTORY / IQC",
        "任务驱动：PURCHASING 生成任务后停在 WAITING_APPROVAL",
        "其余 18 个岗位仅注册表条目，本结构为补齐目标"
      ]
    }
  ]
