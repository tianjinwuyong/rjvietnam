# PostgreSQL connection
PGHOST=127.0.0.1
PGPORT=5432
PGUSER=postgres
PGPASSWORD=your_password_here
PGDATABASE=smt_factory

# API service
API_PORT=8080

# Realtime service
REALTIME_PORT=8081

# JWT secret (generate a strong random string for production)
JWT_SECRET=change_me_in_production

# Use enforce in production. Use flag only for controlled test sessions.
MES_SIGNATURE_ENFORCEMENT=enforce
MES_SIGNATURE_FLAG_UNTIL=

# LLM router: local Qwen via Ollama; optional MiniMax premium fallback
LLM_ROUTER_PROVIDER=omniroute
OMNIROUTE_BASE_URL=http://127.0.0.1:20128/v1
OMNIROUTE_MODEL=auto/coding
OPENAI_BASE_URL=http://127.0.0.1:20128/v1
OPENAI_API_KEY=local
QWEN_MODEL=qwen2.5:7b
MINIMAX_BASE_URL=https://api.minimaxi.com/v1
MINIMAX_MODEL=MiniMax-M2.7
MINIMAX_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_API_KEY=
IQC_AGENT_PROVIDER=minimax
IQC_LLM_MODEL=MiniMax-M2.7
IQC_LLM_TIMEOUT_MS=120000
# Hermes model route: Hy4 first, then automatic local Ollama fallback.
# Hy4 hosted APIs are not permanently free; keep the key only in the runtime .env.
HERMES_LLM_BASE_URL=https://openrouter.ai/api/v1
HERMES_LLM_MODEL=tencent/hy4-preview
HERMES_LLM_API_KEY=
HERMES_LLM_TIMEOUT_MS=180000
HERMES_LLM_SITE_URL=
HERMES_LLM_APP_NAME=Ruijing Hermes
HERMES_LOCAL_MODEL=qwen3.8:latest
# Enterprise WeChat group-bot webhook used by PURCHASING-VIRTUAL-01.
VIRTUAL_EMPLOYEE_WECOM_WEBHOOK_URL=
