{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "server",
  "compilerOptions": {
    "deleteOutDir": false,
    "tsConfigPath": "tsconfig.node.json",
    "typeCheck": false,
    "assets": ["**/*.html", "database/*.sql"],
    "watchAssets": true,
    "builder": {
      "type": "swc",
      "options": {
        "swcrcPath": ".swcrc"
      }
    }
  }
}
