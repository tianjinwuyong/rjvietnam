# ===== 服务端配置 =====
NODE_ENV=production
SERVER_HOST=0.0.0.0
SERVER_PORT=3000

# ===== 数据库配置 =====
# 方式一：使用完整连接字符串
# DATABASE_URL=postgresql://postgres:password@localhost:5432/wms

# 方式二：分开配置（二选一）
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=factory

# ===== JWT 配置 =====
JWT_SECRET=please-change-this-to-a-random-secret-key-for-production

# ===== 前端配置 =====
VITE_API_BASE_URL=/api

# ===== CORS 跨域白名单 =====
# 逗号分隔的可信 Origin。留空 / 不配置 = 不启用跨域放行，仅允许同源访问 ——
# 本系统前端与 API 同源（PC 用 http://服务器IP:3000，PDA 用 https://服务器IP:3443），
# 默认部署无需配置此项。仅在需要外部系统跨域调用 API 时才填写。
# 安全提示：切勿填写 * ；该值决定哪些站点可携带凭证跨域访问接口。
# CORS_ORIGINS=http://192.168.1.119:3000,http://wms.example.com

# ===== MES / 第三方开放接口 =====
# 逗号分隔的 API Key 列表，格式「Key:调用方名称」（名称只用于日志）。
# 不配置 = 接口整体关闭（返回 503），不是故障。
# 接口文档：docs/MES对接WMS接口文档-v1.md
# MES_API_KEYS=7f3c9a1e5b2d4c6f8a0e:mes-prod

# ===== 超期/预警物料每日扫描 =====
# 每天固定时刻自动扫描良品仓超期/预警库存，推送 IQC 待检清单（超期的同时锁库存）。
# 默认 08:30（服务器本地时区）；服务在当天计划时刻之后才启动时会延时 30s 补跑一次。
# EXPIRY_SCAN_TIME=08:30
# 置 1 可临时关闭自动扫描（页面的「立即扫描」按钮仍可用）
# EXPIRY_SCAN_DISABLED=1

# ===== MES 工单/领料接入（2026-10-31）=====
# 接口文档：docs/MES工单下发接口_对接文档_20261030.md
# 密钥也可在「MES 接入」页面填写，页面配置优先于这里
MES_BASE_URL=http://192.168.6.27:8080
MES_API_KEY=
MES_SYNC_ENABLED=false
MES_SYNC_INTERVAL_MIN=5
MES_AUTO_PICKING=false
