# WMS 运行配置示例
# install.sh 会自动生成 .env（随机密码），一般不需要手工改这个文件。
# 只有想自定义端口/库名时，先复制成 .env 再改。

# 对外端口（宿主机）
HTTP_PORT=3000
HTTPS_PORT=3443

# 数据库
DB_USER=postgres
DB_PASSWORD=请改成强密码
DB_NAME=factory

# 登录令牌密钥（随机 48 位以上，改动后所有人需要重新登录）
JWT_SECRET=请改成一长串随机字符

# HTTPS 证书口令（与 ssl/wms-cert.pfx 一致）
SSL_PFX_PASSPHRASE=wms2024

# 时区
TZ=Asia/Shanghai
