# ── SMT Factory API Server ────────────────────────────────────────────────────
FROM node:20-slim

WORKDIR /app

# Copy all workspace source (node_modules excluded by .dockerignore)
COPY apps/ apps/
COPY database/ database/
COPY integrations/ integrations/
COPY packages/ packages/
COPY services/ services/

# Copy workspace manifests. package-lock.json is the authoritative lockfile for this
# npm-workspaces repo; the pnpm lock this file used to copy did not exist, so the
# install below resolved fresh versions on every build.
COPY package.json package-lock.json ./

# `npm ci` fails when the lockfile disagrees with package.json -- which is the point.
RUN npm ci --omit=dev --ignore-scripts

EXPOSE 8080

CMD ["node", "services/api/server.js"]
