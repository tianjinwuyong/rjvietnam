{
  "name": "smt-factory-system",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node ./scripts/dev-all.mjs",
    "dev:watchdog": "npm --workspace services/watchdog run dev",
    "dev:web": "npm --workspace apps/web run dev",
    "dev:scanner": "npm --prefix apps/pdas/scanner-terminal run dev",
    "dev:display": "npm --workspace apps/display-board run dev",
    "dev:agent": "npm --workspace apps/station-agent run dev",
    "dev:api": "npm --workspace services/api run dev",
    "dev:realtime": "npm --workspace services/realtime run dev",
    "dev:worker": "npm --workspace services/worker run dev",
    "build": "npm --workspace apps/web run build",
    "test": "vitest run",
    "test:unit": "vitest run --config vitest.unit.config.ts",
    "test:grade": "vitest run --config vitest.grade.config.ts",
    "test:live": "vitest run live",
    "test:e2e": "playwright test",
    "test:hardware": "vitest run tests/smart-shelf-hardware.test.ts --config vitest.hardware.config.ts",
    "check:syntax": "node scripts/check-api-syntax.mjs",
    "typecheck": "tsc -p tsconfig.base.json --noEmit",
    "typecheck:tests": "tsc -p tsconfig.tests.json --noEmit",
    "typecheck:all": "npm run typecheck && npm run typecheck:tests",
    "migrate": "node scripts/migrate.mjs",
    "admin:create": "node scripts/create-admin.mjs",
    "typecheck:api": "node scripts/typecheck-api.mjs",
    "check:i18n": "node scripts/check-i18n-trilingual.mjs",
    "check:auth-order": "node scripts/check-auth-order.mjs",
    "check:migrations": "node scripts/check-migrations.mjs",
    "check:route-census": "node scripts/check-route-census.mjs",
    "check:route-shadowing": "node scripts/check-route-shadowing.mjs",
    "check:picking-drift": "node scripts/check-picking-drift.mjs",
    "check:iqc-divergence": "node scripts/check-iqc-divergence.mjs",
    "check:register-deps": "node scripts/check-register-deps.mjs",
    "check:integration": "node scripts/check-integration-contracts.mjs",
    "report:ve": "node scripts/ve-report.mjs",
    "runner:ve": "node scripts/ve-runner.mjs",
    "learn:ve": "node scripts/ve-learn.mjs",
    "knowledge:ve": "node scripts/ve-knowledge.mjs",
    "competency:ve": "node scripts/ve-competency.mjs",
    "check:ve-capabilities": "node scripts/check-ve-capabilities.mjs",
    "doc:ve-capabilities": "node scripts/ve-capabilities-doc.mjs",
    "approve:ve": "node scripts/ve-approve.mjs",
    "schedule:ve": "node scripts/ve-scheduler.mjs"
  },
  "workspaces": [
    "apps/*",
    "services/*",
    "packages/*"
  ],
  "dependencies": {
    "canvas": "^3.2.3",
    "mammoth": "^1.12.0",
    "mysql2": "^3.11.0",
    "pdf-parse": "^2.4.5",
    "playwright": "^1.61.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "sqlite3": "^6.0.1",
    "typescript": "^5.8.0",
    "vitest": "^4.1.9",
    "word-extractor": "^1.0.4",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/pg": "^8.20.0",
    "@vitejs/plugin-react": "^5.2.0",
    "esbuild": "^0.28.1",
    "pg": "^8.22.0",
    "vite": "5.4.21"
  }
}
