{
  "$schema": "https://opencode.ai/config.json",
  "model": "freellmapi/auto",
  "provider": {
    "freellmapi": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "FreeLLMAPI",
      "options": {
        "baseURL": "http://127.0.0.1:3001/v1",
        "apiKey": "{env:FREELLMAPI_API_KEY}"
      },
      "models": {
        "auto": {
          "name": "Auto (router picks the best available model)",
          "limit": {
            "context": 128000,
            "output": 8192
          }
        },
        "fusion": {
          "name": "Fusion (panel of models answer in parallel, a judge synthesizes one answer)",
          "limit": {
            "context": 128000,
            "output": 8192
          }
        }
      }
    }
  },
  "mcp": {
    "graft": {
      "type": "local",
      "command": [
        "graft",
        "mcp"
      ],
      "enabled": true,
      "timeout": 120000
    },
    "factory-mailbox": {
      "type": "local",
      "command": [
        "C:/Users/tianj/AppData/Local/Programs/Python/Python314/python.exe",
        "C:/Users/tianj/Desktop/越南工厂瑞晶/agents/opencode/redis_mcp.py"
      ],
      "env": {
        "RJVN_AGENT_NAME": "opencode"
      },
      "enabled": true
    }
  }
}
