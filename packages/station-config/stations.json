      "permitResults": ["PASS"],
      "blockOnMissingSlot": true,
      "blockOnIdentityMismatch": true,
      "blockOnDuplicateToken": true
    },
    "limits": {
      "maxOfflineMinutes": 30,
      "blockNewProductRegistration": true,
      "blockBindingChanges": true,
      "blockRouteChanges": true,
      "blockNewRetestAuthorization": true
    },
    "recovery": {
      "freezePeerDecisionsImmediately": true,
      "reconcileOutboxBeforeNormalRelease": true,
      "mesDecisionWins": true,
      "alarmOnConflict": true
    },
    "offlineRepair": {
      "enabled": true,
      "policySource": "LAST_MES_PUBLISHED_POLICY",
      "triggeredByComponentConfiguration": true,
      "automaticTriggers": ["TIME_THRESHOLD", "QUANTITY_THRESHOLD", "DESIGNATED_TIME", "END_OF_SHIFT", "SPECIAL_REQUEST"],
      "allowed": [
