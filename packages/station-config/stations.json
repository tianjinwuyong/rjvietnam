        "REPAIR_STATION_SCAN_RECEIPT",
        "RECORD_REPAIR_PROCESS",
        "RECORD_MATERIAL_USAGE",
        "CREATE_TEMP_RETURN_HANDOFF_TO_ICT_OR_FCT",
        "APPEND_TO_IMMUTABLE_LOCAL_OUTBOX"
      ],
      "forbidden": [
        "MODIFY_REPAIR_ROUTE",
        "INCREASE_RETEST_LIMIT",
        "ADD_AUTHORIZED_PERSON",
        "SCRAP_WITHOUT_MES",
        "FINAL_QUALITY_RELEASE_WITHOUT_MES",
        "DELETE_NG_HISTORY",
        "OVERWRITE_NG_HISTORY"
