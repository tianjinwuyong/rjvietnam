# SMT Factory System — build/dev overrides
#
# VITE_API_BASE is a DEV-ONLY override: apps/web/src/api/client.ts only honours
# it when import.meta.env.DEV is true. Production builds always resolve the API
# to their own origin, because the web container's nginx proxies /api/ itself.
# Keeping the value here is therefore harmless for release builds, but it was
# previously baked into a production bundle and pointed every browser at a LAN
# address that outside clients cannot reach (rjms, 2026-11-20).
#
# To develop against a different backend, run the Vite dev server with this
# variable set in the shell instead of committing it:
#   $env:VITE_API_BASE="http://192.168.6.155:8080"; npm run dev
VITE_API_BASE=http://192.168.6.155:8080