<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.CAMERA" />
    <application
        android:theme="@style/AppTheme"
        android:label="SMT Material Loading PDA"
        android:usesCleartextTraffic="true">
        <activity android:name=".MainActivity" android:screenOrientation="portrait" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity android:name=".ScannerActivity" android:screenOrientation="portrait" android:exported="false" />
    </application>
</manifest>
