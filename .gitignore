yarn.lock
pnpm-lock.yaml

# Cache files
.eslintcache
*.tsbuildinfo

# swc wasm
.swc

# Agent files
.agent/
.npm_cache

# 数据库备份（本地运维产物，不入库）
backups/
*.dump

# 值守运行时（内嵌 node 约 85MB，不入库）
runtime/

# 证书与私钥（严禁入库）
ssl/
*.pfx
*.pem
*.key

# 数据库导出与备份（含真实数据，严禁入库）
db-backup/
*.sql.gz

# 环境变量备份
.env.bak*
.env.*.bak

# 构建/发布产物快照
dist.bak*/
build.bak*/
